# Copy to .env and enter your real MAX bot token. Do not commit .env.
MAX_BOT_TOKEN=

# polling: events with /messages fallback; messages: direct post polling; webhook: HTTPS server.
MAX_RECEIVE_MODE=polling
MAX_WEBHOOK_SECRET=

# Credentials for the web panel. Use a long, unique password.
MAX_WEB_USER=admin
MAX_WEB_PASSWORD=

# Start monitoring automatically when the container starts.
MAX_AUTO_START=true
MAX_WEB_PORT=8000
